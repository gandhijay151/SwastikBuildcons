# Base URL of the backend API (no trailing slash).
# Set this for production builds so the frontend calls the correct HTTPS API origin.
# If unset: localhost uses http://<host>:5027, other hosts fall back to same-origin (page protocol).
VITE_API_BASE_URL=https://api.swastikbuildcons.com

# Optional contact-link overrides used by the contact form.
VITE_COMPANY_PHONE=918511003888
VITE_COMPANY_WHATSAPP=https://wa.me/918511003888
