ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL connection string (Npgsql key=value format).
# Double underscore (__) maps to nested config: ConnectionStrings:Default
ConnectionStrings__Default=Host=your-host.neon.tech;Database=neondb;Username=USER;Password=PASSWORD;SSL Mode=Require;Channel Binding=Require

# Frontend domain(s) allowed by CORS. Must be your real domain, not localhost.
Cors__AllowedOrigins__0=https://swastikbuildcons.com
Cors__AllowedOrigins__1=https://www.swastikbuildcons.com

# Admin login. Set a strong password (app refuses to start in Production if blank/default).
AdminAuth__Username=admin
AdminAuth__Password=CHANGE_TO_A_STRONG_PASSWORD

# JWT signing key for admin login tokens (HS256). Must be at least 32 characters;
# the app refuses to start in Production if blank/too short. Keep this secret.
Jwt__SigningKey=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=SwastikBuildcons
Jwt__Audience=SwastikBuildconsAdmin
Jwt__ExpiryMinutes=480

# SMTP for lead notification emails. Leave blank to disable email (leads still stored).
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=noreply@swastikbuildcons.com
Smtp__FromName=Swastik Buildcons Website
Smtp__ToEmail=info@swastikbuildcons.com
